<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\WebBuilders.Domains.Business\WebBuilders.Domains.Business.csproj" />
    <ProjectReference Include="..\WebBuilders.Domains.Data\WebBuilders.Domains.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e4a0d0c1-759a-4f5a-aa0a-afd145a14e91</UserSecretsId>
  </PropertyGroup>

  <!-- On publish, ship the static website in wwwroot so one IIS site serves both the pages and the API.
       During development the site is served straight from the repository root (Site:Root = ../../..). -->
  <PropertyGroup>
    <SiteSourceRoot>$(MSBuildProjectDirectory)\..\..\..\</SiteSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <SitePage Include="$(SiteSourceRoot)*.html" />
    <SiteAsset Include="$(SiteSourceRoot)css\**;$(SiteSourceRoot)js\**;$(SiteSourceRoot)assets\**;$(SiteSourceRoot)admin\**" />

    <ResolvedFileToPublish Include="@(SitePage)" RelativePath="wwwroot\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <ResolvedFileToPublish Include="@(SiteAsset)" RelativePath="wwwroot\$([MSBuild]::MakeRelative($(SiteSourceRoot), %(FullPath)))" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
