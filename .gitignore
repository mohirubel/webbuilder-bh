# ---------------------------------------------------------------
#  Web Builders — website + .NET Domains API
# ---------------------------------------------------------------

# --- .NET build output ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
publish/
*.nupkg
*.snupkg

# --- Visual Studio / Rider / VS Code ---
.vs/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates
*.rsuser
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --- Test results / coverage ---
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.trx

# --- Secrets & local configuration (never commit keys) ---
# Keys live in .NET user-secrets (outside the repo). The deploy script copies them into
# artifacts/publish/appsettings.Production.json, so that file must never be committed either.
*.env
.env.*
appsettings.Production.json
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.pem
*.key

# --- Deployment ---
# Build output of .\deploy-server. Rebuilt on every deploy and contains the server keys.
artifacts/
deploy/*.local.json

# --- Old layout (code now lives in src/; delete this folder once Visual Studio is closed) ---
server/

# --- Node (if front-end tooling is added later) ---
node_modules/
npm-debug.log*

# --- OS files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
