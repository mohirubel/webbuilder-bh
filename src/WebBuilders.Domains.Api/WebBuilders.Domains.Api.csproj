<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Presentation tier and composition root: references both other tiers to wire them together. -->
  <PropertyGroup>
    <UserSecretsId>e4a0d0c1-759a-4f5a-aa0a-afd145a14e91</UserSecretsId>
    <!-- Run through "dotnet WebBuilders.Domains.Api.dll" (also what IIS uses), never a generated .exe:
         some machines block unsigned executables ("Access is denied"). -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebBuilders.Domains.Business\WebBuilders.Domains.Business.csproj" />
    <ProjectReference Include="..\WebBuilders.Domains.Data\WebBuilders.Domains.Data.csproj" />
  </ItemGroup>

  <!-- On publish, ship the static website in wwwroot so one site serves both the pages and the API.
       Locally the website is served straight from /website (Website:Root in appsettings.Development.json). -->
  <PropertyGroup>
    <WebsiteSourceRoot>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), '..', '..', 'website'))</WebsiteSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <WebsiteFile Include="$(WebsiteSourceRoot)**" />
    <ResolvedFileToPublish Include="@(WebsiteFile)" RelativePath="wwwroot\$([MSBuild]::MakeRelative($(WebsiteSourceRoot), %(FullPath)))" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Local-only settings stay off the server. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
